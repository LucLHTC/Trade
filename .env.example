# Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=traderpwd

# API Configuration
API_HOST=api
API_PORT=8000
API_BASE_URL=http://api:8000

# Timezone
TZ=UTC

# Alpha Vantage API
ALPHAVANTAGE_API_KEY=YOUR_API_KEY_HERE

# Trading Configuration
INITIAL_EQUITY=10000.00
RISK_PER_TRADE=0.01
MAX_TRADES_PER_WEEK=3

# Model Configuration
MODEL_PATH=models/current/model.pkl
SHADOW_MODEL_PATH=models/shadow/model.pkl
TRAINING_WINDOW_DAYS=90
VALIDATION_WINDOW_DAYS=10

# Drift Detection
DRIFT_PSI_THRESHOLD=0.25
DRIFT_KS_PVALUE=0.01

# Feature Engineering
LOOKAHEAD_PERIODS=3
LABEL_THRESHOLD_MULTIPLIER=0.7

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/errors

# Scheduler
SCHEDULER_ENABLED=true
HOURLY_JOBS_ENABLED=true
DAILY_JOBS_ENABLED=true
