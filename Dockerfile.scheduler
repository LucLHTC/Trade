FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (git needed for pandas-ta from GitHub)
RUN apt-get update && apt-get install -y \
    gcc \
    git \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install pandas-ta from GitHub (not available on PyPI for Python 3.11)
RUN pip install --no-cache-dir git+https://github.com/twopirllc/pandas-ta.git@main

# Copy application code
COPY src ./src
COPY data ./data
COPY models ./models
COPY logs ./logs

# Set Python path
ENV PYTHONPATH=/app

CMD ["python", "-m", "src.scheduler.jobs"]
